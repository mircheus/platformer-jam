--- !u!114 &7650395246898074020
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1372293792729492636}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87e0007a564fef04ab50e29333cdafc4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Minigames.PuzzleMinigame
  colorButtons:
  - {fileID: 4995463905866892473}
  - {fileID: 803841965450328238}
  - {fileID: 7540680881588682350}
  - {fileID: 733607745237104440}
  - {fileID: 4953134426406787123}
  npcLines:
  - "\u0422\u0440\u0430\u0432\u0430 \u043D\u0430\u0434 \u043D\u043E\u0440\u043E\u0439
    \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F. \u0410 \u043D\u0430
    \u043D\u0435\u0439 \u043E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A \u0441\u0438\u044F\u0435\u0442.
    \u0412\u0441\u0435 \u0436\u0435 \u044F\u0440\u0447\u0435 \u043E\u043D, \u0447\u0435\u043C
    \u043F\u043E\u043B\u0435 \u0432\u043E\u043A\u0440\u0443\u0433."
  - "\u041F\u043E\u043C\u043D\u044E, \u0433\u0440\u044F\u0434\u043A\u0438 \u044F
    \u043A\u043E\u043F\u0430\u043B, \u043D\u0430 \u043C\u0435\u043D\u044F \u0432\u0435\u0434\u0440\u043E
    \u0443\u043F\u0430\u043B\u043E. \u0421\u043E\u043A \u0442\u043E\u043C\u0430\u0442\u043D\u044B\u0439
    \u0441\u043B\u0451\u0437\u044B \u0432\u044B\u0448\u0438\u0431, \u0437\u043B\u043E\u0431\u043D\u043E
    \u0432\u0434\u0440\u0443\u0433 \u043C\u043D\u0435 \u0441\u0442\u0430\u043B\u043E!"
  - "\u041F\u043E\u043C\u043D\u044E \u0441\u0442\u0440\u0435\u043A\u043E\u0442 \u0432
    \u0442\u0438\u0448\u0438\u043D\u0435. \u0423\u0439\u043C\u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u0432
    \u043B\u043E\u0432\u0438\u043B, \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u043C\u0435\u043D\u044C\u0448\u0435
    \u043B\u0435\u0442 \u043C\u043D\u0435 \u0431\u044B\u043B\u043E."
  - "\u0420\u044B\u043B \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0432 \u0436\u0430\u0440\u0443
    \u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0451\u0439, \u0445\u043E\u0442\u044C
    \u0431\u044B \u043A\u0430\u043F\u043B\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C.
    \u0422\u043E\u043B\u044C\u043A\u043E \u0433\u043B\u0438\u043D\u0430 \u0441\u0443\u0445\u0430\u044F
    \u0438 \u0437\u043D\u043E\u0439 \u2014 \u0430 \u0433\u043B\u043E\u0442\u043E\u0447\u043A\u0430
    \u0432\u043E\u0434\u044B \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C!"
  npcMistakeLine: "\u041A\u0430\u0436\u0435\u0442\u0441\u044F \u043D\u0430\u043F\u0443\u0442\u0430\u043B
    \u0442\u044B \u0447\u0442\u043E-\u0442\u043E. \u0414\u0430\u0432\u0430\u0439
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430!"
  correctSequence: 02000000010000000000000003000000
  npcCurrentLine: {fileID: 2377094195334264768}
