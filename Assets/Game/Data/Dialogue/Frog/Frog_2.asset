  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: Frog_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: Frog
  voiceClip: {fileID: 8300000, guid: 2c53922e6d4ad8a4a99394af9d94d9aa, type: 3}
  lines:
  - text: "\u0412\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u043E! \u041D\u0438
      \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0443\u0441\u0442\u043E\u0433\u043E
      \u043C\u0435\u0441\u0442\u0430! \u042F \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0430."
    minigameAfter: {fileID: 0}
  - text: "\u0421\u043E\u0433\u043B\u0430\u0441\u043D\u043E \u043C\u043E\u0438\u043C
      \u0440\u0430\u0441\u0447\u0451\u0442\u0430\u043C, \u0442\u0432\u043E\u0439
      \u043B\u0438\u0444\u0442 \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043F\u043E\u0434\u043D\u044F\u0442\u044C...
      \u041E\u0447\u0435\u043D\u044C \u043C\u043D\u043E\u0433\u043E \u0433\u0440\u0438\u0431\u043E\u0432."
    minigameAfter: {fileID: 0}
  - text: "\u041D\u0443 \u0447\u0442\u043E \u0436, \u044F \u043F\u043E\u0448\u043B\u0430
      \u0434\u043E\u043C\u043E\u0439, \u0443\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435. \u0410 \u0442\u044B
      \u0438\u0434\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0441\u0432\u043E\u0438\u043C
      \u0434\u0435\u043B\u0430\u043C, \u043C\u043D\u0435 \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0434\u043E \u0442\u0435\u0431\u044F."
    minigameAfter: {fileID: 0}
