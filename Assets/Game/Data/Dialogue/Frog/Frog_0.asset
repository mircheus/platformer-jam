MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: Frog_0
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: Frog
  voiceClip: {fileID: 8300000, guid: 2c53922e6d4ad8a4a99394af9d94d9aa, type: 3}
  lines:
  - text: "\u041F\u0440\u0438\u0432\u0435\u0442, \u041F\u0430\u0443\u043A! \u0410
      \u043A\u0430\u043A \u044D\u0442\u043E \u0442\u044B \u0442\u0443\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F?
      \u0420\u0430\u043D\u044C\u0448\u0435 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0430,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0430\u0443\u043A\u0438 \u0442\u0430\u043A
      \u0432\u044B\u0441\u043E\u043A\u043E \u0437\u0430\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C."
    minigameAfter: {fileID: 0}
  - text: "\u041E, \u0433\u0440\u0438\u0431\u044B \u043E\u0442 \u041A\u0440\u043E\u0442\u0430?
      \u0418\u0437\u0443\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E! \u041F\u043E\u043B\u043E\u0441\u0430\u0442\u0430\u044F
      \u0448\u043B\u044F\u043F\u043A\u0430, \u0442\u0440\u0438 \u043A\u043E\u043B\u044C\u0446\u0430
      \u043D\u0430 \u043D\u043E\u0436\u043A\u0435... \u0414\u0430 \u044D\u0442\u043E
      \u0436\u0435 \u0440\u0435\u0434\u0447\u0430\u0439\u0448\u0438\u0439 \u041F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0439
      \u0428\u0443\u0440\u0448\u0443\u043D!"
    minigameAfter: {fileID: 0}
  - text: "\u041D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E, \u043D\u043E
      \u043F\u0440\u0438\u044F\u0442\u043D\u043E. \u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442
      \u043C\u043E\u0439 \u0444\u0443\u043D\u0433\u0430\u0440\u0438\u0439. "
    minigameAfter: {fileID: 0}
  - text: "\u041F\u043E\u0441\u0442\u043E\u0439... \u0422\u044B \u0432\u0435\u0434\u044C
      \u0442\u043E\u0442 \u041F\u0430\u0443\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B
      \u043B\u0438\u0444\u0442? \u042F \u0441\u043B\u044B\u0448\u0430\u043B\u0430
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u0446\u0435\u043B\u0438\u0439."
    minigameAfter: {fileID: 0}
  - text: "\u0423 \u043C\u0435\u043D\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C
      \u0438\u0434\u0435\u044F!"
    minigameAfter: {fileID: 0}
