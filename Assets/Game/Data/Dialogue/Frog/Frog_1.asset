  dialogueID: Frog
  voiceClip: {fileID: 8300000, guid: 2c53922e6d4ad8a4a99394af9d94d9aa, type: 3}
  lines:
  - text: "\u0412\u0438\u0434\u0438\u0448\u044C \u043B\u0438, \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u043E \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043C\u043E\u0438 \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430
      \u0432 \u043E\u0434\u043D\u0443 \u043A\u043E\u0440\u043E\u0431\u043A\u0443.
      \u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u0438\u0445 \u0441\u043E\u0431\u0440\u0430\u0442\u044C,
      \u0438 \u0437\u0430\u043E\u0434\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043C
      \u0433\u0440\u0443\u0437\u043E\u043F\u043E\u0434\u044A\u0435\u043C\u043D\u043E\u0441\u0442\u044C
      \u0442\u0432\u043E\u0435\u0433\u043E \u041B\u0438\u0444\u0442\u0430!"
    minigameAfter: {fileID: 11400000, guid: 7ad8ba12ada4c54448c12f4a49a366f9, type: 2}
