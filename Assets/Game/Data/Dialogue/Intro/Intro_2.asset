  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: Intro_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 
  voiceClip: {fileID: 0}
  lines:
  - text: "\u0412\u0441\u0435 \u043F\u0440\u043E\u043F\u0430\u043B\u043E... \u0427\u0442\u043E
      \u0436\u0435 \u0434\u0435\u043B\u0430\u0442\u044C? "
    minigameAfter: {fileID: 0}
  - text: "\u041F\u0440\u0438\u0434\u0443\u043C\u0430\u043B! \u041F\u043E\u0441\u0442\u0440\u043E\u044E-\u043A\u0430
      \u044F \u043B\u0438\u0444\u0442! \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u044E,
      \u0447\u0435\u043C \u0441\u043E\u0441\u0435\u0434\u0438 \u0436\u0438\u0432\u0443\u0442,
      \u043C\u043E\u0436\u0435\u0442, \u043A\u043E\u043C\u0443-\u0442\u043E \u043F\u043E\u043C\u043E\u0449\u044C
      \u043C\u043E\u044F \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u044D\u0442\u0438 \u0441\u0443\u0440\u043E\u0432\u044B\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0430..."
    minigameAfter: {fileID: 0}
