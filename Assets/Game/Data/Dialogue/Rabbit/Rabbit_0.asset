  dialogueID: 
  voiceClip: {fileID: 8300000, guid: da87c44edeba29442aef944e37eed072, type: 3}
  lines:
  - text: "\u0410\u0410\u0410! \u0427\u0442\u043E \u0442\u044B \u0437\u0430 \u0447\u0443\u0434\u0438\u0449\u0435
      \u0442\u0430\u043A\u043E\u0435? \u0417\u0430\u0447\u0435\u043C \u043F\u0440\u0438\u043F\u043E\u043B\u0437? "
    minigameAfter: {fileID: 0}
  - text: "\u0418 \u0442\u0430\u043A \u0432\u0441\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0441\u043A\u0440\u0438\u043F \u0441\u043B\u044B\u0448\u0443."
    minigameAfter: {fileID: 0}
  - text: "\u041A\u0430\u043A \u0436\u0435 \u043C\u043D\u0435 \u0443\u0441\u043D\u0443\u0442\u044C
      \u0443\u0436\u0435!"
    minigameAfter: {fileID: 11400000, guid: c4c89189ba3836c4f96bc07c1083a3c4, type: 2}
