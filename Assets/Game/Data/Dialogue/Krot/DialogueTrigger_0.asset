MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: DialogueTrigger_0
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 4
  voiceClip: {fileID: 8300000, guid: 43ad5adf5d112ab4fa5b36aac3d0e8c5, type: 3}
  lines:
  - text: "\u0417\u0434\u0435\u0441\u044C \u043A\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C?  "
    minigameAfter: {fileID: 0}
  - text: "\u0410, \u044D\u0442\u043E \u0442\u044B... \u0443\u0437\u043D\u0430\u043B
      \u0442\u0435\u0431\u044F \u043F\u043E \u0437\u0430\u043F\u0430\u0445\u0443
      \u043F\u044B\u043B\u0438."
    minigameAfter: {fileID: 0}
  - text: "\u0412\u0438\u0436\u0443, \u0442\u044B \u0442\u0443\u0442 \u0446\u0435\u043B\u044B\u0439
      \u043B\u0438\u0444\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B,
      \u0443\u0432\u0430\u0436\u0430\u044E!"
    minigameAfter: {fileID: 0}
  - text: "\u041D\u043E, \u044F \u0442\u0443\u0442 \u043F\u043E\u0449\u0443\u043F\u0430\u043B
      \u043F\u0430\u043D\u0435\u043B\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
      \u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0443 \u0442\u0435\u0431\u044F
      \u043A\u043D\u043E\u043F\u043A\u0430 \u043E\u0442\u043B\u0435\u0442\u0435\u043B\u0430.
      \u041F\u043E\u0438\u0449\u0438 \u0435\u0435 \u043F\u043E \u0443\u0433\u043B\u0430\u043C!
      \u0412\u0438\u0436\u0443 \u044F \u043F\u043B\u043E\u0445\u043E, \u0430 \u0431\u0435\u0437
      \u044D\u0442\u043E\u0439 \u043A\u043D\u043E\u043F\u043A\u0438 \u0442\u043E
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0435\u0434\u0435\u0448\u044C"
    minigameAfter: {fileID: 0}
