  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: 4_Krot_2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 4
  lines:
  - text: "\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u0443\u044E,
      \u0441\u043E\u0441\u0435\u0434! \u0423\u0436 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0442\u043E \u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0442\u0432\u043E\u0438\u043C \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435\u043C
      \u0431\u0443\u0434\u0435\u0442 \u0435\u0449\u0435 \u043F\u0440\u043E\u0449\u0435!"
    minigameAfter: {fileID: 0}
  - text: "\u042D\u0445, \u0437\u0440\u044F \u043C\u043E\u043B\u0432\u044F\u0442,
      \u0447\u0442\u043E \u0442\u044B \u0436\u0443\u0442\u043A\u0438\u0439 \u0442\u0438\u043F.
      \u042F \u0445\u043E\u0442\u044C \u0438 \u043D\u0435 \u0432\u0438\u0436\u0443
      \u0442\u0432\u043E\u0435\u0433\u043E \u043B\u0438\u0446\u0430, \u043D\u043E
      \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E, \u0447\u0442\u043E \u0443
      \u0442\u0435\u0431\u044F \u0434\u043E\u0431\u0440\u0430\u044F \u0434\u0443\u0448\u0430!"
    minigameAfter: {fileID: 0}
  - text: "*\u0421\u0442\u0440\u043E\u0447\u043A\u0430 \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u043E\u0442\u0441\u044B\u043B\u0430\u0435\u0442 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0443*"
    minigameAfter: {fileID: 0}
