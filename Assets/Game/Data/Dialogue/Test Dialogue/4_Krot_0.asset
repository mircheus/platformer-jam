  m_Script: {fileID: 11500000, guid: 8addc9c0d1acaba4ca8405719a24abfc, type: 3}
  m_Name: 4_Krot_0
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  dialogueID: 4
  lines:
  - "\u0417\u0434\u0435\u0441\u044C \u043A\u0442\u043E-\u0442\u043E \u0435\u0441\u0442\u044C?"
  - "\u0410, \u044D\u0442\u043E \u0442\u044B... \u0443\u0437\u043D\u0430\u043B \u0442\u0435\u0431\u044F
    \u043F\u043E \u0437\u0430\u043F\u0430\u0445\u0443 \u043F\u044B\u043B\u0438."
  - "\u0422\u0443\u0442, \u0432\u0438\u0434\u0438\u0448\u044C \u043B\u0438, \u0443
    \u0442\u0435\u0431\u044F \u0432\u0441\u0435 \u043F\u043E\u043F\u0443\u0442\u0430\u043D\u043E,
    \u0445\u043E\u0442\u044C \u0438 \u0441\u0434\u0435\u043B\u0430\u043D\u043E \u0442\u043E\u043B\u043A\u043E\u0432\u043E!
    \u041C\u0430\u0448\u0438\u043D\u0430, \u0447\u0442\u043E \u043D\u0430\u0434\u043E!"
  - "\u0415\u0441\u043B\u0438 \u0434\u043E\u0434\u0435\u043B\u0430\u0435\u043C \u0442\u0432\u043E\u0439
    \u043B\u0438\u0444\u0442, \u0442\u043E \u0431\u0443\u0434\u0435\u043C \u0432\u043E\u043E\u0431\u0449\u0435
    \u0435\u0437\u0434\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u0431\u0435\u0437
    \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0435\u0439 \u043F\u043E\u043C\u043E\u0449\u0438!"
  - "\u041D\u043E \u0437\u0440\u0435\u043D\u0438\u0435 \u0443 \u043C\u0435\u043D\u044F
    \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0438\u043A\u0443\u0434\u044B\u0448\u043D\u043E\u0435.
    \u0426\u0432\u0435\u0442\u0430 \u0432\u0441\u0435 \u043A\u0430\u043A \u043E\u0434\u0438\u043D.
    \u0411\u0438\u0442\u044B\u0439 \u0447\u0430\u0441 \u0441 \u044D\u0442\u043E\u0439
    \u043F\u0430\u043D\u0435\u043B\u044C\u044E \u043A\u043E\u043F\u0430\u044E\u0441\u044C."
  - "\u0415\u0449\u0435 \u0438 \u043A\u043D\u043E\u043F\u043A\u0430 \u043E\u0442\u043B\u0435\u0442\u0435\u043B\u0430,
    \u0438 \u044F \u043D\u0438\u043A\u0430\u043A \u0435\u0435 \u043D\u0435 \u043D\u0430\u0439\u0434\u0443.
    \u041F\u043E\u0438\u0449\u0438 \u0435\u0435 \u043F\u043E \u0443\u0433\u043B\u0430\u043C,
    \u0431\u0443\u0434\u044C \u0434\u043E\u0431\u0440!"
